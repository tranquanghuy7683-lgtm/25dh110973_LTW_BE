@model _25dh110973_LTW.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>
<h4 class="alert-danger" style="padding:10px;">Bạn có chắc chắn muốn xóa danh mục này không?</h4>

<div>
    <dl class="dl-horizontal">
        <dt>Tên danh mục</dt>
        <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-primary" /> |
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
        </div>
    }
</div>
