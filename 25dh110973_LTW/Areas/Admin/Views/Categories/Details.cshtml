@model _25dh110973_LTW.Models.Category
@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="bg-success">CHI TIẾT DANH MỤC</h2>
<dl class="dl-horizontal">
    <dt>Tên danh mục</dt>
    <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
</dl>
<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>
