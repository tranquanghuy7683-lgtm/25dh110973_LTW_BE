<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TRANG QUẢN TRỊ</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { padding-top: 50px; }
        .bg-success { background-color: #dff0d8; padding: 10px; border-radius: 4px; }
        .bg-info { background-color: #d9edf7; padding: 15px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                @Html.ActionLink("My Store", "Index", "Products", new { area = "Admin" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, null)</li>
                    <li>@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Khách hàng", "Index", "Customer", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Đơn hàng", "Index", "Order", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Tài khoản", "Index", "Account", new { area = "Admin" }, null)</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="container body-content" style="margin-top: 20px;">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Tên ứng dụng</p>
            <h4>Contact</h4>
            <p>Tên các thành viên trong nhóm</p>
        </footer>
    </div>
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
